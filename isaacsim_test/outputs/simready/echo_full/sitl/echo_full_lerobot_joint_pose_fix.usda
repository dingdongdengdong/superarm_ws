#usda 1.0
(
    defaultPrim = "echo_full"
    metersPerUnit = 1
    subLayers = [
        @echo_full_lerobot_articulation.usda@
    ]
    upAxis = "Z"
)

over "echo_full"
{
    custom int joint_pose_fix:authoredJointCount = 29
    custom string joint_pose_fix:mode = "joint-pose-fix layer"
    custom string joint_pose_fix:policy = "Authors localRot0/localRot1 from each body's current world orientation so initial joint constraint frames are aligned."
    custom string[] joint_pose_fix:remainingWork = ["isaac_sim_runtime_joint_stability_test", "collider_reauthoring", "mass_inertia_tuning", "drive_gain_tuning"]

    over "lerobot_joints"
    {
        over "world_fixed_base"
        {
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (-0.5, -0.5, -0.5, -0.5)
        }

        over "fixed_base_01"
        {
            quatf physics:localRot0 = (-0.5, -0.5, -0.5, -0.5)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        over "fixed_base_02"
        {
            quatf physics:localRot0 = (-0.5, -0.5, -0.5, -0.5)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        over "fixed_base_03"
        {
            quatf physics:localRot0 = (-0.5, -0.5, -0.5, -0.5)
            quatf physics:localRot1 = (0.70710677, -0.70710677, 0, 0)
        }

        over "fixed_base_04"
        {
            quatf physics:localRot0 = (-0.5, -0.5, -0.5, -0.5)
            quatf physics:localRot1 = (0.70710677, -0.70710677, -1.9626155e-17, -1.9626155e-17)
        }

        over "fixed_base_05"
        {
            quatf physics:localRot0 = (-0.5, -0.5, -0.5, -0.5)
            quatf physics:localRot1 = (0.70710677, 2.2202089e-16, -2.2692743e-16, -0.70710677)
        }

        over "fixed_base_06"
        {
            quatf physics:localRot0 = (-0.5, -0.5, -0.5, -0.5)
            quatf physics:localRot1 = (0.70710677, 9.9357415e-17, -2.4655358e-16, -0.70710677)
        }

        over "fixed_base_07"
        {
            quatf physics:localRot0 = (-0.5, -0.5, -0.5, -0.5)
            quatf physics:localRot1 = (0.70710677, 1.9914535e-16, -0.70710677, 1.9914535e-16)
        }

        over "fixed_base_08"
        {
            quatf physics:localRot0 = (-0.5, -0.5, -0.5, -0.5)
            quatf physics:localRot1 = (0.70710677, 2.0037198e-16, -0.70710677, 2.0037198e-16)
        }

        over "fixed_base_09"
        {
            quatf physics:localRot0 = (-0.5, -0.5, -0.5, -0.5)
            quatf physics:localRot1 = (0.70710677, -0.70710677, 2.287608e-17, -2.287608e-17)
        }

        over "fixed_base_10"
        {
            quatf physics:localRot0 = (-0.5, -0.5, -0.5, -0.5)
            quatf physics:localRot1 = (0.70710677, 2.2324723e-16, -2.1834128e-16, -0.70710677)
        }

        over "fixed_base_11"
        {
