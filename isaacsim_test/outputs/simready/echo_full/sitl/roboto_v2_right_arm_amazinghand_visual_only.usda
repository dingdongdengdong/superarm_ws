    def Scope "arm_hand_visual_metadata"
    {
        custom string authoring_mode = "visual_only_arm_hand_wrapper"
        custom string authoring_note = "Visual-only USDA for Isaac Sim. Physics should be imported from roboto_v2_right_arm_amazinghand_full.urdf; non-arm echo frame, wheels, lidar, camera, and RealSense visual branches are deactivated."
