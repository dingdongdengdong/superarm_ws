<?xml version="1.0" ?>
<robot name="robot_arm_hand_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="joint_rev_1_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="joint_rev_1">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="joint_rev_1_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

