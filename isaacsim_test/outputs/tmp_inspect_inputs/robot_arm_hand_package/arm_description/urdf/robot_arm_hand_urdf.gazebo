  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>true</selfCollide>
</gazebo>

<gazebo reference="wrist_adapter_arm">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
