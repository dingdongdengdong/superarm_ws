# Copy this file to isaacsim_test/.env and fill in your values.
# docker compose will load it automatically.

# Absolute path to the superarm_ws repo on your host
SUPERARM_WS_PATH=/home/sim/Documents/superarm_ws

# ROS2 DDS domain — choose a value that doesn't clash with other containers
ROS_DOMAIN_ID=42

# Physical scene source. Default is hybrid:
# custom visual USD (arm + hand + frame assembly) plus direct physical URDF
# (Roboto V2 right arm first, then AmazingHand attached at J5/wrist).
# Set USE_SIMREADY_USD=1 only for SimReady visual/provenance diagnostics.
USE_SIMREADY_USD=0
# Keep this disabled unless SIMREADY_ARTICULATION_USD_PATH is a real physics
# articulation USD, not the default provenance/visual manifest.
USE_SIMREADY_ARTICULATION_USD=0
LOAD_CUSTOM_VISUAL_USD=1
CUSTOM_VISUAL_USD_PATH=/workspace/superarm_ws/isaacsim_test/outputs/simready/echo_full/sitl/echo_full_lerobot_articulation.usda
CUSTOM_VISUAL_PRIM_PATH=/World/echo_full_visual
PHYSICAL_ROBOT_URDF_PATH=/workspace/superarm_ws/isaacsim_test/outputs/simready/echo_full/sitl/roboto_v2_right_arm_amazinghand_full.urdf
SIMREADY_ARTICULATION_USD_PATH=/workspace/superarm_ws/isaacsim_test/outputs/simready/echo_full/sitl/echo_full_lerobot_articulation.usda
SIMREADY_USD_PATH=/workspace/superarm_ws/isaacsim_test/outputs/simready/echo_full/pipeline/04_conform/repair-loop-02-fet005/fet005-grasp/echo_full_robot_arm_hand.usd
SIMREADY_THUMBNAIL_PATH=/workspace/superarm_ws/isaacsim_test/outputs/simready/echo_full/pipeline/07_render/thumbnail.png

# 1 = headless (no GUI window), 0 = headed (requires xhost +local:docker first)
HEADLESS=1

# Optional screenshot capture knobs for Isaac Sim evidence runs.
SCREENSHOT_ON_STARTUP=0
SCREENSHOT_AFTER_COMMAND=0
SCREENSHOT_PATH=/workspace/superarm_ws/isaacsim_test/artifacts/echo_full_simready_target.png
EXIT_AFTER_SCREENSHOT=1

# Optional batch motion screenshot case runner. Use the helper script below for
# repeatable physical-scene screenshots while the Isaac timeline is playing.
MOTION_SCREENSHOT_CASES_PATH=
MOTION_SCREENSHOT_CASES_JSON=
MOTION_SCREENSHOT_OUTPUT_DIR=/workspace/superarm_ws/isaacsim_test/artifacts/simready_motion_cases
MOTION_SCREENSHOT_SETTLE_STEPS=30
EXIT_AFTER_MOTION_SCREENSHOTS=1

# Port the phone web server (custom slider UI) listens on
# NOTE: 8765 is reserved for the Foxglove WebSocket bridge — do not use it here
PHONE_PORT=8766
NUM_JOINTS=6
JOINT_NAMES=right_arm_pitch_joint,right_arm_roll_joint,right_arm_yaw_joint,right_elbow_pitch_joint,right_elbow_yaw_joint,amazinghand_grasp

# Foxglove WebSocket bridge port (standard default — used by Foxglove Studio / mobile)
FOXGLOVE_PORT=8765
