From 361f1719f50411f4b5b0c47c8937dcfb2c29602e Mon Sep 17 00:00:00 2001
From: Codex <codex@example.local>
Date: Mon, 6 Jul 2026 05:56:43 +0000
Subject: [PATCH] Use RoboParty V2 right arm for Isaac Sim backend

---
 lelab/teleoperate.py      |  5 +++--
 tests/test_teleoperate.py | 43 +++++++++++++++++++++++++++++++--------
 2 files changed, 38 insertions(+), 10 deletions(-)

diff --git a/lelab/teleoperate.py b/lelab/teleoperate.py
index 675dcde..4a50cd2 100644
--- a/lelab/teleoperate.py
+++ b/lelab/teleoperate.py
@@ -109,7 +109,8 @@ def get_joint_positions_from_robot(robot) -> dict[str, float]:
         observation = robot.capture_observation().get("observation.state", [])
 
     # Generic LeRobot custom robot path.  Our Isaac Sim bridge exposes feature
-    # keys like joint_rev_1.pos and does not use the SO-101 URDF joint names.
+    # keys such as right_arm_pitch_joint.pos and does not use the SO-101 URDF
+    # joint names.
     if isinstance(observation, dict) and not any(
         f"{name}.pos" in observation
         for name in ("shoulder_pan", "shoulder_lift", "elbow_flex", "wrist_flex", "wrist_roll", "gripper")
@@ -202,7 +203,7 @@ def _create_isaacsim_rpo_arm_robot(request: TeleoperateRequest):
     config_path = Path(
         request.isaacsim_config
         or request.follower_config
-        or (lerobot_dir / "source_arm_isaacsim_arm_only.yaml")
+        or (lerobot_dir / "rpo_arm_isaacsim.yaml")
     )
     if not config_path.is_absolute():
         config_path = superarm_ws / config_path
diff --git a/tests/test_teleoperate.py b/tests/test_teleoperate.py
index eb9efe9..74c04da 100644
--- a/tests/test_teleoperate.py
+++ b/tests/test_teleoperate.py
@@ -173,10 +173,12 @@ def test_isaacsim_backend_uses_custom_robot_and_action_endpoint(
 
         def get_observation(self) -> dict[str, float]:
             return {
-                "joint_rev_1.pos": 0.1,
-                "joint_rev_2.pos": -0.2,
-                "joint_rev_3.pos": 0.3,
-                "joint_rev_4.pos": -0.4,
+                "right_arm_pitch_joint.pos": 0.1,
+                "right_arm_roll_joint.pos": -0.2,
+                "right_arm_yaw_joint.pos": 0.3,
+                "right_elbow_pitch_joint.pos": -0.4,
+                "right_elbow_yaw_joint.pos": 0.5,
+                "amazinghand_grasp.pos": 1.0,
             }
 
         def send_action(self, action):
@@ -190,18 +192,43 @@ def test_isaacsim_backend_uses_custom_robot_and_action_endpoint(
         leader_port="unused",
         follower_port="unused",
         leader_config="unused",
-        follower_config="isaacsim_test/lerobot/source_arm_isaacsim_arm_only.yaml",
+        follower_config="isaacsim_test/lerobot/rpo_arm_isaacsim.yaml",
         robot_backend="isaacsim_rpo_arm",
     )
     result = teleop.handle_start_teleoperation(request)
 
     assert result["success"] is True
     assert result["robot_backend"] == "isaacsim_rpo_arm"
-    assert result["joint_positions"]["joint_rev_1"] == 0.1
+    assert result["joint_positions"]["right_arm_pitch_joint"] == 0.1
 
-    action_result = teleop.handle_send_joint_action(teleop.JointActionRequest(action=[0.2, -0.2, 0.3, -0.3]))
+    action = [0.2, -0.2, 0.3, -0.3, 0.4, 1.0]
+    action_result = teleop.handle_send_joint_action(teleop.JointActionRequest(action=action))
     assert action_result["success"] is True
-    assert action_result["sent_action"] == [0.2, -0.2, 0.3, -0.3]
+    assert action_result["sent_action"] == action
 
     stop_result = teleop.handle_stop_teleoperation()
     assert stop_result["success"] is True
+
+
+def test_isaacsim_backend_default_config_is_roboparty_v2_right_arm(monkeypatch: pytest.MonkeyPatch) -> None:
+    import lelab.teleoperate as teleop
+
+    request = teleop.TeleoperateRequest(
+        leader_port="unused",
+        follower_port="unused",
+        leader_config="unused",
+        follower_config="",
+        robot_backend="isaacsim_rpo_arm",
+        superarm_ws_path="/workspaces/superarm_ws",
+    )
+
+    robot = teleop._create_isaacsim_rpo_arm_robot(request)
+
+    assert robot.config.joint_names == [
+        "right_arm_pitch_joint",
+        "right_arm_roll_joint",
+        "right_arm_yaw_joint",
+        "right_elbow_pitch_joint",
+        "right_elbow_yaw_joint",
+        "amazinghand_grasp",
+    ]
-- 
